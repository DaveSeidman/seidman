{
  "name": "seidman",
  "version": "0.3.2",
  "description": "the cli portfolio of dave seidman",
  "main": "index.js",
  "repository": "https://gitlab.com/daveseidman/seidman",
  "scripts": {
    "dev": "nodemon",
    "start": "node index.js",
    "postinstall": "node index.js"
  },
  "author": "dave seidman",
  "license": "ISC",
  "dependencies": {
    "auto-bind": "^5.0.1",
    "blessed": "^0.1.81",
    "inquirer": "^8.2.0",
    "node-nlp": "^4.22.9",
    "open": "^8.4.0",
    "terminal-kit": "^2.3.0"
  },
  "devDependencies": {
    "nodemon": "^1.19.1",
    "eslint": "^5.6.1",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.1",
    "eslint-plugin-react": "^7.11.1"
  },
  "eslintConfig": {
    "extends": "airbnb",
    "env": {
      "node": true,
      "browser": true,
      "es6": true
    },
    "rules": {
      "no-console": 0,
      "no-underscore-dangle": 0,
      "curly": 0,
      "object-curly-newline": 0,
      "max-len": 0,
      "class-methods-use-this": 0,
      "no-lonely-if": 0,
      "no-param-reassign": 0,
      "no-nested-ternary": 0,
      "camelcase": 0,
      "no-restricted-properties": 0,
      "no-alert": 0,
      "consistent-return": 0
    }
  }
}
