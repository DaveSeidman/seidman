{
  "name": "seidman",
  "version": "0.4.2",
  "description": "the cli portfolio of dave seidman",
  "main": "index.js",
  "bin": {
    "seidman": "bin/seidman.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DaveSeidman/seidman.git"
  },
  "scripts": {
    "start": "node bin/seidman.js",
    "dev": "node bin/seidman.js --dev",
    "dev:watch": "node scripts/dev-watch.js",
    "postinstall": "node scripts/postinstall.js",
    "train": "cd modules/nlp && node train"
  },
  "author": "dave seidman",
  "license": "ISC",
  "dependencies": {
    "node-nlp": "^4.22.9",
    "open": "^8.4.0"
  },
  "devDependencies": {
    "eslint": "^5.6.1",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.1",
    "eslint-plugin-react": "^7.11.1",
    "nodemon": "^3.1.14"
  },
  "eslintConfig": {
    "extends": "airbnb",
    "env": {
      "node": true,
      "browser": true,
      "es6": true
    },
    "rules": {
      "no-console": 0,
      "no-underscore-dangle": 0,
      "curly": 0,
      "object-curly-newline": 0,
      "max-len": 0,
      "class-methods-use-this": 0,
      "no-lonely-if": 0,
      "no-param-reassign": 0,
      "no-nested-ternary": 0,
      "camelcase": 0,
      "no-restricted-properties": 0,
      "no-alert": 0,
      "consistent-return": 0
    }
  }
}
